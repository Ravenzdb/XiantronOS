# XiantronOS local development
NODE_ENV=development
DATABASE_URL=postgresql://xiantron:xiantron@localhost:5432/xiantron
REDIS_URL=redis://localhost:6379

# Application secrets: supply locally; never commit real values.
JWT_SECRET=
ENCRYPTION_KEY=

# Optional AI provider configuration
AI_PROVIDER=local
AI_API_KEY=

# Optional object storage
OBJECT_STORAGE_URL=
